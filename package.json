{
  "name": "@cyrus/dsh-plugins",
  "version": "0.0.3",
  "description": "DeepSeek Harness plugin collection: installs and registers the plugins listed in cordis.patch.yml (currently Sessions Insight). Also the workspace root they are built from.",
  "keywords": [
    "chatgpt",
    "claude",
    "codex",
    "deepseek",
    "deepseek-harness",
    "deepseek-plugin",
    "dsh",
    "dsh-plugin",
    "plugin"
  ],
  "homepage": "https://github.com/Mt-Youya/dsh-plugins",
  "license": "MIT",
  "author": "Cyrus Doyle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mt-Youya/dsh-plugins.git"
  },
  "files": [
    "cordis.patch.yml",
    "locale",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "plugins/sessions-insight/README.md",
    "plugins/sessions-insight/README.en.md",
    "plugins/sessions-insight/LICENSE",
    "plugins/sessions-insight/icon.svg",
    "plugins/sessions-insight/docs/images/**/*.png",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config apps/preview/vite.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "css": "node scripts/build-css.mjs plugins/sessions-insight",
    "build": "pnpm css && pnpm typecheck && pnpm typecheck:client && tsdown && pnpm build:libs",
    "build:libs": "pnpm --filter './packages/*' -r run build",
    "pack:insight": "pnpm --filter @cyrus/dsh-sessions-insight release:patch",
    "pack:collection": "pnpm pack",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "fmt": "oxfmt --write .",
    "lint": "oxlint --fix",
    "dsh:remove-insight": "dsh plugin --profile desktop remove @cyrus/dsh-sessions-insight",
    "install:plugin": "bash scripts/install-plugin.sh"
  },
  "dependencies": {
    "@cyrus/dsh-sessions-insight": "workspace:^"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@12.14.0",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}

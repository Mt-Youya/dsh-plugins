{
  "name": "@cyrusdoyle/dsh-plugins",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin collection: installs and registers the plugins listed in cordis.patch.yml (currently Sessions Insight). Also the workspace root they are built from.",
  "keywords": [
    "chatgpt",
    "claude",
    "codex",
    "deepseek",
    "deepseek-harness",
    "deepseek-plugin",
    "dsh",
    "dsh-plugin",
    "plugin"
  ],
  "homepage": "https://github.com/Mt-Youya/dsh-plugins",
  "license": "MIT",
  "author": "Cyrus Doyle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mt-Youya/dsh-plugins.git"
  },
  "files": [
    "/cordis.patch.yml",
    "locale",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config apps/preview/vite.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "check:ui": "node scripts/check-session-menu.mjs",
    "css": "node scripts/build-css.mjs plugins/sessions-insight",
    "build": "pnpm css && pnpm typecheck && pnpm typecheck:client && tsdown --minify",
    "pack:insight": "pnpm --filter @cyrusdoyle/dsh-sessions-insight release:patch",
    "pack:collection": "pnpm pack",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "dsh:remove-insight": "dsh plugin --profile desktop remove @cyrusdoyle/dsh-sessions-insight",
    "install:plugin": "bash scripts/install-plugin.sh"
  },
  "dependencies": {
    "@cyrusdoyle/dsh-sessions-insight": "workspace:^",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@12.16.1",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}

{
  "name": "@cyrus/dsh-plugins",
  "version": "0.0.1",
  "description": "DeepSeek Harness plugin collection: installs and registers the plugins listed in cordis.patch.yml (currently Context Lens). Also the workspace root they are built from.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/Mt-Youya/dsh-plugins",
  "license": "MIT",
  "author": "Cyrus Doyle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mt-Youya/dsh-plugins.git"
  },
  "files": [
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config apps/preview/vite.config.ts",
    "css": "node scripts/build-css.mjs plugins/context-insight",
    "build": "pnpm css && pnpm typecheck && pnpm typecheck:client && tsdown && pnpm build:libs",
    "build:libs": "pnpm --filter './packages/*' -r run build",
    "pack:insight": "pnpm --filter '@cyrus/dsh-context-insight' release:patch",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "fmt": "oxfmt --write .",
    "lint": "oxlint --fix",
    "dsh:remove-insight": "dsh plugin --profile desktop remove @cyrus/dsh-context-insight",
    "install:plugin": "bash scripts/install-plugin.sh"
  },
  "dependencies": {
    "@cyrus/dsh-context-insight": "workspace:^"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@12.11.2",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

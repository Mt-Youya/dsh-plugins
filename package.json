{
  "name": "dsh-plugins",
  "version": "0.0.1",
  "private": true,
  "description": "Workspace root: the context-insight DSH plugin and the internal packages it is built from.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/preview/vite.config.ts",
    "css": "node scripts/build-css.mjs plugins/context-insight",
    "build": "pnpm css && pnpm typecheck && pnpm typecheck:client && tsdown && pnpm build:libs",
    "build:libs": "pnpm --filter './packages/*' -r run build",
    "pack:insight": "pnpm --filter '@cyrus/dsh-context-insight' release:patch",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "fmt": "oxfmt --write .",
    "lint": "oxlint --fix",
    "dsh:remove-insight": "dsh plugin --profile desktop remove @cyrus/dsh-context-insight",
    "install:plugin": "bash scripts/install-plugin.sh"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@12.11.2"
}
